# Salin ke .env lalu isi. Semua variabel opsional; tanpa Telegram, alert hanya dicatat di ledger.

# --- Telegram (bot via @BotFather, chat id via @userinfobot) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_MODE=polling            # polling | webhook | off
# Chat yang boleh /setthreshold dan /setalpha (dipisah koma). Kosong = TELEGRAM_CHAT_ID saja.
ALLOWED_CHAT_IDS=
# Token untuk PUT /config/threshold (header X-Admin-Token). Kosong = endpoint admin nonaktif.
ADMIN_API_TOKEN=
# URL publik service, untuk link baris ledger di pesan alert
PUBLIC_BASE_URL=

# --- Simbol & keputusan ---
SYMBOLS=BTCUSDT
# Kosong = threshold dari kurva precision-recall validasi (models/metadata.json)
ALERT_PROB_THRESHOLD=
ALERT_COOLDOWN_MINUTES=15
MODEL_TIMEOUT_SEC=2.0
HMM_GATE=high                    # off | high | transition

# --- Adaptive conformal threshold ---
CONFORMAL_ENABLED=true
CONFORMAL_ALPHA=0.20             # target porsi alert palsu jangka panjang
CONFORMAL_GAMMA=0.01             # laju adaptasi

# --- Circuit breaker ---
STREAM_STALE_SEC=5
BREAKER_RECOVERY_SEC=30
BREAKER_STREAMS=kline,aggTrade,depth

# --- Binance (default binance.vision: tidak diblokir dari server AS; futures fstream diblokir dari AS) ---
# BINANCE_WS_URL=wss://stream.binance.com:9443
# BINANCE_REST_URL=https://api.binance.com
ENABLE_FUTURES=true
RECORD_TICKS=false               # rekam semua pesan mentah ke Parquet (replay, parity)

# --- Redis & DB (docker compose mengisi ini otomatis) ---
# REDIS_URL=rediss://default:<password>@<host>.upstash.io:6379
# DATABASE_URL=postgresql+psycopg://postgres:<password>@db.<project>.supabase.co:5432/postgres
# LEDGER_PATH=data/ledger.db

# --- Mode hosting gratis 1 service ---
# RUN_INGESTION=true
